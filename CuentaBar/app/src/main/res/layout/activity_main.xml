<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202020"
    android:orientation="vertical"
    android:useDefaultMargins="true"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cuenta"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="40dp"
        android:drawableStart="@drawable/beer"
        android:drawablePadding="8dp"
        android:drawableTint="#E6B450"
        android:drawableEnd="@drawable/beer"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#292929"
        app:contentPadding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:drawableStart="@drawable/calculate"
                android:drawablePadding="8dp"
                android:drawableTint="#E6B450"/>

            <EditText
                android:id="@+id/totalCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:textSize="30dp"
                android:layout_gravity="center"
                android:textColor="#333333"
                android:background="#FFFFFF"
                android:hint="0,00 €"
                android:textColorHint="#888888"
                android:inputType="numberDecimal"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#292929"
        app:contentPadding="16dp">

        <CheckBox
            android:id="@+id/propinaSi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/propina"
            android:textColor="@color/white"
            android:layoutDirection="rtl"
            android:textDirection="ltr"
            android:buttonTint="#E6B450"
            android:drawableEnd="@drawable/gift"
            android:drawablePadding="8dp"
            android:drawableTint="#E6B450"
            />

        <SeekBar
            android:id="@+id/porcentajePropina"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="30"
            android:min="10"
            android:progressBackgroundTint="@color/white"
            android:thumbTint="@color/white"
            android:layout_gravity="bottom"
            android:progress="10"/>

        <TextView
            android:id="@+id/valorPropina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#E6B450"
            android:gravity="center"
            android:text="10 %"/>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#292929"
        app:contentPadding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/metodoPago"
            android:textColor="@color/white"
            android:drawableStart="@drawable/tarjeta"
            android:drawablePadding="8dp"
            android:drawableTint="#E6B450"/>

        <RadioGroup
            android:id="@+id/grupoBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_gravity="center">

            <RadioButton
                android:id="@+id/efectivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/efectivo"
                android:buttonTint="#E6B450"
                android:textColor="@color/white"/>

            <RadioButton
                android:id="@+id/tarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tarjeta"
                android:buttonTint="#E6B450"
                android:textColor="@color/white" />

        </RadioGroup>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#292929"
        app:contentPadding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calificacion"
            android:textColor="@color/white"
            android:drawableStart="@drawable/star"
            android:drawablePadding="8dp"
            android:drawableTint="#E6B450"/>

        <RatingBar
            android:id="@+id/calificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:numStars="5"
            android:progressTint="#E6B450"
            android:rating="0"
            android:stepSize="0.5" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/calcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calcular"
        android:textStyle="bold"
        android:textColor="#333333"
        android:textAllCaps="false"
        android:backgroundTint="#E6B450"
        app:icon="@drawable/calculate"
        app:iconTint="#333333"
        app:iconGravity="textStart"
        app:iconPadding="15dp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#292929"
        app:contentPadding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/resultado"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/resultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#E6B450"
            android:textSize="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/resultadoTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"/>

    </androidx.cardview.widget.CardView>

</LinearLayout>